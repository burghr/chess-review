# Copy to .env next to docker-compose.yml. Compose reads this file automatically,
# so you never have to remember to export anything on the command line.
#
#   cp .env.example .env   &&   docker compose up -d --build

# Your Chess.com username, the one in your profile URL.
CHESS_REVIEW_USER=

# Minutes between automatic syncs.
CHESS_REVIEW_INTERVAL=60

# Stockfish depth per position. 14 is a few seconds a game.
CHESS_REVIEW_DEPTH=14

# Engine threads. Leave headroom if the box does anything else.
CHESS_REVIEW_THREADS=2

# Games analyzed per scheduled run, so a big backlog drains over several runs.
CHESS_REVIEW_BATCH=200

# Set to 1 to also sync the moment the container starts.
CHESS_REVIEW_SYNC_ON_START=0

# --- Move explanations ---------------------------------------------------
# Leave blank to auto-pick: Anthropic if ANTHROPIC_API_KEY is set, else local.
CHESS_REVIEW_LLM_PROVIDER=
CHESS_REVIEW_LLM_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# Local OpenAI-compatible server (MLX, llama.cpp, LM Studio, Ollama).
# From inside Docker, localhost is the container: use host.docker.internal on
# Docker Desktop, or the host's LAN address. MLX is Apple Silicon only.
# CHESS_REVIEW_LLM_BASE_URL=http://host.docker.internal:8080/v1
CHESS_REVIEW_LLM_BASE_URL=

# Some local servers require a key. Sent as Authorization: Bearer and x-api-key.
CHESS_REVIEW_LLM_API_KEY=
